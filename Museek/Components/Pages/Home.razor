@page "/home"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Museek.Data
@using Museek.Domain
@inject IJSRuntime JSRuntime
@inject IDbContextFactory<MuseekContext> DbFactory

<PageTitle>Museek | Home</PageTitle>

<!-- Search Bar -->
<section class="search-section">
    <div class="search-wrap">
        <div class="search-bar">
            <img src="images/search.png" alt="Search" class="search-icon" />
            <input type="text"
                   @bind="searchQuery"
                   @bind:event="oninput"
                   @onkeyup="@HandleSearch"
                   placeholder="Search songs, artists, or albums..." />
        </div>

        @if (showSearchResults)
        {
            <div class="search-results">
                @if (isSearching)
                {
                    <div class="search-empty">Searching...</div>
                }
                else if (searchResults.Count == 0)
                {
                    <div class="search-empty">No songs found.</div>
                }
                else
                {
                    @foreach (var r in searchResults)
                    {
                        <button type="button" class="search-item" @onclick="@(() => PlayFromSearch(r))">
                            <img src="@GetImageSrc(r.CoverArt)" alt="@r.Title" class="search-item-img" />
                            <div class="search-item-meta">
                                <div class="search-item-title">@r.Title</div>
                                <div class="search-item-sub">Song · @r.ArtistName</div>
                            </div>
                        </button>
                    }
                }
            </div>
        }
    </div>
</section>

<!-- Page Grid -->
<div class="page-grid">
    <!-- Left Side (Content) -->
    <main class="left-content">
        <section class="music-section">
            <h2>Popular Songs</h2>

            <div class="row-scroll">
                <div class="music-grid">
                    @foreach (var song in popularSongs)
                    {
                        <div class="music-card" @onclick="@(() => PlaySong(song))">
                            <img src="@song.Image" alt="@song.Title">
                            <h4>@song.Title</h4>
                            <p>@song.Artist</p>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="music-section">
            <h2>Trending Artists</h2>

            <div class="row-scroll">
                <div class="artist-grid">
                    @foreach (var artist in trendingArtists)
                    {
                        <a class="artist-card" href="@($"/albums?artistId={artist.Id}")">
                            <img src="@artist.Image" alt="@artist.Name">
                            <h4>@artist.Name</h4>
                        </a>
                    }
                </div>
            </div>
        </section>

        <section class="music-section">
            <h2>New Releases</h2>

            <div class="row-scroll">
                <div class="music-grid">
                    @foreach (var release in newReleases)
                    {
                        <div class="music-card" @onclick="@(() => PlaySong(release))">
                            <img src="@release.Image" alt="@release.Title">
                            <h4>@release.Title</h4>
                            <p>@release.Artist</p>
                        </div>
                    }
                </div>
            </div>
        </section>
    </main>

    <!-- Right Side (Video and Player) -->
    <aside class="right-content">
        <section class="video-box">
            <div class="video-frame">
                <video autoplay muted loop playsinline>
                    <source src="videos/Advetisement.mp4" type="video/mp4">
                    <source src="videos/Advertisement.webm" type="video/webm">
                    Your browser does not support the video tag.
                </video>
            </div>
        </section>

        @if (showPlayer)
        {
            <section class="player-box">
                <button class="close-button" type="button" @onclick="ClosePlayer">×</button>

                <div class="player-left">
                    <img id="songCover" src="@currentSong.Image" alt="Cover" />
                    <div class="song-info">
                        <h4 id="songTitle">@currentSong.Title</h4>
                        <p id="songArtist">@currentSong.Artist</p>
                    </div>
                </div>

                <div class="player-controls">
                    <input type="range" id="progressBar" min="0" max="100" value="@progress" @oninput="@SeekAudio" />
                    <div class="control-buttons">
                        <img src="@(shuffleOn ? "images/shuffle.png" : "images/shuffleButton.png")"
                             alt="Shuffle"
                             class="control-icon"
                             @onclick="@ToggleShuffle" />
                        <img src="images/prevButton.png" alt="Previous" class="control-icon" @onclick="@PreviousSong" />
                        <img src="@(isPlaying ? "images/pauseButton.png" : "images/playButton.png")"
                             id="playPause"
                             alt="Play"
                             class="control-icon main"
                             @onclick="@TogglePlayPause" />
                        <img src="images/nextButton.png" alt="Next" class="control-icon" @onclick="@NextSong" />
                        <img src="@GetRepeatIcon()" alt="Repeat" class="control-icon" @onclick="@ToggleRepeat" />
                    </div>
                    <div class="time-display">
                        <span id="currentTime">@currentTime</span>
                        <span id="remainingTime">-@remainingTime</span>
                    </div>
                </div>

                <div class="volume-control">
                    <img src="images/volume.png" alt="Volume" class="control-icon" />
                    <input type="range" id="volumeBar" min="0" max="100" value="@volume" @oninput="@ChangeVolume" />
                </div>

                <audio id="audioPlayer" src="@GetEncodedAudioPath(currentSong.AudioPath)"></audio>
            </section>
        }
    </aside>
</div>

@code {
    private string _searchQuery = "";
    private string searchQuery
    {
        get => _searchQuery;
        set
        {
            if (_searchQuery == value) return;
            _searchQuery = value ?? "";
            _ = LoadSongSearchAsync();
        }
    }

    private List<SearchSongVm> searchResults = new();
    private bool isSearching = false;

    private bool showSearchResults =>
        !string.IsNullOrWhiteSpace(searchQuery) && searchQuery.Trim().Length >= 2;

    private string searchRequestId = "";

    private bool isPlaying = false;
    private double progress = 0;
    private double volume = 70;
    private string currentTime = "00:00";
    private string remainingTime = "00:00";

    private bool showPlayer = false;

    private List<HomeSongCard> popularSongs = new();
    private List<HomeArtistCard> trendingArtists = new();
    private List<HomeSongCard> newReleases = new();

    private HomeSongCard currentSong = new HomeSongCard
    {
        Title = "",
        Artist = "",
        Image = "",
        AudioPath = "",
        SongId = 0
    };

    private List<HomeSongCard> playbackQueue = new();
    private int currentIndex = -1;

    private bool shuffleOn = false;
    private int repeatMode = 0;

    private readonly Random rng = new();
    private Stack<int> shuffleHistory = new();

    private DotNetObjectReference<object>? dotNetRef;
    private bool jsWired = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadHomeRandomDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initializeAudioPlayer");
        }
    }

    private async Task LoadHomeRandomDataAsync()
    {
        using var db = DbFactory.CreateDbContext();

        // Popular Songs: random songs from DB
        popularSongs = await GetRandomSongCardsAsync(db, take: 12);

        // New Releases: random songs from DB (still random, no ReleasedDate in Song entity)
        newReleases = await GetRandomSongCardsAsync(db, take: 12);

        // Trending Artists: random artists from DB
        trendingArtists = await GetRandomArtistCardsAsync(db, take: 12);

        // Build a default playback queue from popular + new releases
        playbackQueue = popularSongs
            .Concat(newReleases)
            .Where(s => !string.IsNullOrWhiteSpace(s.AudioPath))
            .GroupBy(s => (s.AudioPath ?? "").Trim().ToLowerInvariant())
            .Select(g => g.First())
            .ToList();
    }

    private static async Task<List<HomeSongCard>> GetRandomSongCardsAsync(MuseekContext db, int take)
    {
        // OrderBy(Guid.NewGuid()) works with SQL Server EF Core
        // If you use a different provider and it fails, tell me which DB you use and I will switch to provider-safe random.
        var rows = await (
            from s in db.Song.AsNoTracking()
            join a in db.Artist.AsNoTracking() on s.ArtistId equals a.Id
            orderby Guid.NewGuid()
            select new HomeSongCard
            {
                SongId = s.Id,
                Title = s.Title ?? "Untitled",
                Artist = a.Name ?? "Unknown Artist",
                Image = GetImageSrc(s.Cover_Art),
                AudioPath = s.Audio_File ?? ""
            }
        ).Take(take).ToListAsync();

        return rows;
    }

    private static async Task<List<HomeArtistCard>> GetRandomArtistCardsAsync(MuseekContext db, int take)
    {
        var rows = await db.Artist
            .AsNoTracking()
            .OrderBy(a => Guid.NewGuid())
            .Select(a => new HomeArtistCard
            {
                Id = a.Id,
                Name = a.Name ?? "Unknown Artist",
                Image = GetImageSrc(a.Profile_Pic)
            })
            .Take(take)
            .ToListAsync();

        return rows;
    }

    private async Task LoadSongSearchAsync()
    {
        var q = (searchQuery ?? "").Trim();
        if (q.Length < 2)
        {
            searchResults.Clear();
            await InvokeAsync(StateHasChanged);
            return;
        }

        var requestId = Guid.NewGuid().ToString("N");
        searchRequestId = requestId;

        isSearching = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var db = DbFactory.CreateDbContext();

            var results = await (
                from s in db.Song
                join a in db.Artist on s.ArtistId equals a.Id
                where (s.Title ?? "").Contains(q)
                orderby s.Title
                select new SearchSongVm
                {
                    Title = s.Title ?? "",
                    ArtistName = a.Name ?? "",
                    CoverArt = s.Cover_Art ?? "",
                    AudioPath = s.Audio_File ?? "",
                    SongId = s.Id
                }
            ).Take(12).ToListAsync();

            if (searchRequestId != requestId) return;

            searchResults = results;
        }
        catch
        {
            if (searchRequestId != requestId) return;
            searchResults = new();
        }
        finally
        {
            if (searchRequestId == requestId)
            {
                isSearching = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task PlayFromSearch(SearchSongVm r)
    {
        if (string.IsNullOrWhiteSpace(r.AudioPath))
            return;

        var dbSongs = searchResults
            .Where(x => !string.IsNullOrWhiteSpace(x.AudioPath))
            .Select(x => new HomeSongCard
            {
                SongId = x.SongId,
                Title = x.Title,
                Artist = x.ArtistName,
                Image = GetImageSrc(x.CoverArt),
                AudioPath = x.AudioPath
            })
            .ToList();

        playbackQueue = dbSongs
            .Concat(popularSongs)
            .Concat(newReleases)
            .Where(s => !string.IsNullOrWhiteSpace(s.AudioPath))
            .GroupBy(s => (s.AudioPath ?? "").Trim().ToLowerInvariant())
            .Select(g => g.First())
            .ToList();

        currentIndex = playbackQueue.FindIndex(s =>
            string.Equals((s.AudioPath ?? "").Trim(), (r.AudioPath ?? "").Trim(), StringComparison.OrdinalIgnoreCase));

        if (currentIndex < 0)
            currentIndex = 0;

        shuffleHistory.Clear();

        await PlayIndex(currentIndex, forcePlay: true);
    }

    private async Task EnsureEndedWiredAndRepeatApplied()
    {
        if (!jsWired || dotNetRef == null)
            return;

        await JSRuntime.InvokeVoidAsync("museekPlayer.wireEnded", dotNetRef);
        await JSRuntime.InvokeVoidAsync("museekPlayer.setLoop", repeatMode == 2);
    }

    private async Task TogglePlayPause()
    {
        if (!showPlayer)
            return;

        isPlaying = !isPlaying;
        await JSRuntime.InvokeVoidAsync("togglePlayPause");
    }

    private async Task PlaySong(HomeSongCard song)
    {
        // Build queue from current sections so refresh changes the queue
        playbackQueue = popularSongs
            .Concat(newReleases)
            .Where(s => !string.IsNullOrWhiteSpace(s.AudioPath))
            .GroupBy(s => (s.AudioPath ?? "").Trim().ToLowerInvariant())
            .Select(g => g.First())
            .ToList();

        currentIndex = playbackQueue.FindIndex(s =>
            string.Equals((s.AudioPath ?? "").Trim(), (song.AudioPath ?? "").Trim(), StringComparison.OrdinalIgnoreCase));

        if (currentIndex < 0)
            currentIndex = 0;

        shuffleHistory.Clear();

        await PlayIndex(currentIndex, forcePlay: true);
    }

    private async Task PlayIndex(int index, bool forcePlay)
    {
        if (index < 0 || index >= playbackQueue.Count)
            return;

        currentIndex = index;

        var s = playbackQueue[currentIndex];
        currentSong = new HomeSongCard
        {
            SongId = s.SongId,
            Title = s.Title,
            Artist = s.Artist,
            Image = s.Image,
            AudioPath = s.AudioPath
        };

        showPlayer = true;

        StateHasChanged();

        await Task.Delay(50);

        await JSRuntime.InvokeVoidAsync("initializeAudioPlayer");

        dotNetRef ??= DotNetObjectReference.Create<object>(this);
        jsWired = true;

        await EnsureEndedWiredAndRepeatApplied();

        var encodedPath = GetEncodedAudioPath(currentSong.AudioPath);

        await JSRuntime.InvokeVoidAsync("loadAudio", encodedPath);

        if (!isPlaying || forcePlay)
        {
            isPlaying = true;
            await JSRuntime.InvokeVoidAsync("togglePlayPause");
        }
    }

    private async Task ClosePlayer()
    {
        if (!showPlayer)
            return;

        if (isPlaying)
        {
            await JSRuntime.InvokeVoidAsync("togglePlayPause");
        }

        await JSRuntime.InvokeVoidAsync("loadAudio", "");

        isPlaying = false;
        showPlayer = false;

        currentSong = new HomeSongCard
        {
            Title = "",
            Artist = "",
            Image = "",
            AudioPath = "",
            SongId = 0
        };

        progress = 0;
        currentTime = "00:00";
        remainingTime = "00:00";

        currentIndex = -1;
        shuffleHistory.Clear();

        StateHasChanged();
    }

    private async Task PreviousSong()
    {
        if (!showPlayer || playbackQueue.Count == 0 || currentIndex < 0)
            return;

        if (shuffleOn)
        {
            if (shuffleHistory.Count > 0)
            {
                var prev = shuffleHistory.Pop();
                await PlayIndex(prev, forcePlay: true);
                return;
            }
        }

        var nextIndex = currentIndex - 1;
        if (nextIndex < 0)
            nextIndex = playbackQueue.Count - 1;

        await PlayIndex(nextIndex, forcePlay: true);
    }

    private async Task NextSong()
    {
        if (!showPlayer || playbackQueue.Count == 0 || currentIndex < 0)
            return;

        int nextIndex;

        if (shuffleOn)
        {
            shuffleHistory.Push(currentIndex);

            if (playbackQueue.Count == 1)
            {
                nextIndex = currentIndex;
            }
            else
            {
                do
                {
                    nextIndex = rng.Next(0, playbackQueue.Count);
                }
                while (nextIndex == currentIndex);
            }
        }
        else
        {
            nextIndex = currentIndex + 1;
            if (nextIndex >= playbackQueue.Count)
                nextIndex = 0;
        }

        await PlayIndex(nextIndex, forcePlay: true);
    }

    private async Task SeekAudio(ChangeEventArgs e)
    {
        if (!showPlayer)
            return;

        if (double.TryParse(e.Value?.ToString(), out double value))
        {
            progress = value;
            await JSRuntime.InvokeVoidAsync("seekAudio", value);
        }
    }

    private async Task ChangeVolume(ChangeEventArgs e)
    {
        if (!showPlayer)
            return;

        if (double.TryParse(e.Value?.ToString(), out double value))
        {
            volume = value;
            await JSRuntime.InvokeVoidAsync("changeVolume", value / 100);
        }
    }

    private void ToggleShuffle()
    {
        if (!showPlayer)
            return;

        shuffleOn = !shuffleOn;
        shuffleHistory.Clear();
    }

    private async Task ToggleRepeat()
    {
        if (!showPlayer)
            return;

        repeatMode++;
        if (repeatMode > 2)
            repeatMode = 0;

        if (jsWired)
        {
            await JSRuntime.InvokeVoidAsync("museekPlayer.setLoop", repeatMode == 2);
        }
    }

    private string GetRepeatIcon()
    {
        if (repeatMode == 1) return "images/repeat.png";
        if (repeatMode == 2) return "images/repeat1.png";
        return "images/repeatOff.png";
    }

    private void HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Console.WriteLine($"Searching for: {searchQuery}");
        }
    }

    private static string GetEncodedAudioPath(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return "";

        var parts = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var encodedParts = parts.Select(p => Uri.EscapeDataString(p));
        return string.Join("/", encodedParts);
    }

    private static string GetImageSrc(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "images/default-cover.jpg";
        value = value.Trim();

        if (value.StartsWith("//")) return "https:" + value;
        if (value.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
            return "https://" + value.Substring("http://".Length);
        if (value.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return value;

        return "/" + value.TrimStart('/');
    }

    [JSInvokable]
    public async Task OnAudioEnded()
    {
        if (!showPlayer)
            return;

        if (repeatMode == 2)
        {
            await JSRuntime.InvokeVoidAsync("museekPlayer.restart");
            isPlaying = true;
            return;
        }

        if (playbackQueue.Count == 0 || currentIndex < 0)
            return;

        if (shuffleOn)
        {
            await NextSong();
            return;
        }

        var nextIndex = currentIndex + 1;
        if (nextIndex >= playbackQueue.Count)
        {
            if (repeatMode == 1)
            {
                nextIndex = 0;
            }
            else
            {
                await ClosePlayer();
                return;
            }
        }

        await PlayIndex(nextIndex, forcePlay: true);
    }

    private class HomeSongCard
    {
        public int SongId { get; set; }
        public string Title { get; set; } = "";
        public string Artist { get; set; } = "";
        public string Image { get; set; } = "";
        public string AudioPath { get; set; } = "";
    }

    private class HomeArtistCard
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Image { get; set; } = "";
    }

    private class SearchSongVm
    {
        public int SongId { get; set; }
        public string Title { get; set; } = "";
        public string ArtistName { get; set; } = "";
        public string CoverArt { get; set; } = "";
        public string AudioPath { get; set; } = "";
    }

    public async ValueTask DisposeAsync()
    {
        if (dotNetRef != null)
        {
            dotNetRef.Dispose();
        }
    }
}

<script>
    window.museekPlayer = window.museekPlayer || {
        wireEnded: function (dotNetRef) {
            try {
                const audio = document.getElementById("audioPlayer");
                if (!audio) return;

                if (audio._museekEndedHandler) {
                    audio.removeEventListener("ended", audio._museekEndedHandler);
                }

                audio._museekEndedHandler = function () {
                    dotNetRef.invokeMethodAsync("OnAudioEnded");
                };

                audio.addEventListener("ended", audio._museekEndedHandler);
            } catch { }
        },
        setLoop: function (on) {
            try {
                const audio = document.getElementById("audioPlayer");
                if (!audio) return;
                audio.loop = !!on;
            } catch { }
        },
        restart: function () {
            try {
                const audio = document.getElementById("audioPlayer");
                if (!audio) return;
                audio.currentTime = 0;
                audio.play();
            } catch { }
        }
    };
</script>
