@page "/songs/details"
@using Microsoft.EntityFrameworkCore
@using Museek.Domain
@inject IDbContextFactory<Museek.Data.MuseekContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Song</h2>
    <hr />
    @if (song is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <!-- Cover Art preview (playlist-card style, bigger) -->
        <a class="playlist-card" href="javascript:void(0)">
            <img src="@GetImageSrc(song.Cover_Art)"
                 class="playlist-img"
                 alt="Cover Art" />
            <div class="playlist-meta">
                
            </div>
        </a>

        <dl class="row">
            <dt class="col-sm-2">Title</dt>
            <dd class="col-sm-10">@song.Title</dd>
            <dt class="col-sm-2">Audio_File</dt>
            <dd class="col-sm-10">@song.Audio_File</dd>
            <dt class="col-sm-2">Duration</dt>
            <dd class="col-sm-10">@song.Duration</dd>
            <dt class="col-sm-2">Cover_Art</dt>
            <dd class="col-sm-10">@song.Cover_Art</dd>
            <dt class="col-sm-2">AlbumId</dt>
            <dd class="col-sm-10">@song.AlbumId</dd>
            <dt class="col-sm-2">ArtistId</dt>
            <dd class="col-sm-10">@song.ArtistId</dd>
            @* <dt class="col-sm-2">DateCreated</dt>
            <dd class="col-sm-10">@song.DateCreated</dd>
            <dt class="col-sm-2">DateUpdated</dt>
            <dd class="col-sm-10">@song.DateUpdated</dd> *@
            @* <dt class="col-sm-2">CreatedBy</dt>
            <dd class="col-sm-10">@song.CreatedBy</dd>
            <dt class="col-sm-2">UpdatedBy</dt>
            <dd class="col-sm-10">@song.UpdatedBy</dd> *@
        </dl>
        <div>
            <a href="@($"/songs/edit?id={song.Id}")">Edit</a> |
            <a href="@($"/songs")">Back to List</a>
        </div>
    }
</div>

<style>
    .playlist-card {
        text-decoration: none;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.10);
        border-radius: 16px;
        padding: 14px;
        color: white;
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 16px;
        width: 100%;
        max-width: 520px;
    }

        .playlist-card:hover {
            border-color: rgba(255, 255, 255, 0.18);
        }

    .playlist-img {
        width: 100%;
        height: 260px;
        object-fit: cover;
        border-radius: 12px;
        display: block;
    }

    .playlist-meta {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .playlist-title {
        font-weight: 800;
        font-size: 18px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .playlist-desc {
        color: rgba(255, 255, 255, 0.65);
        font-size: 14px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>

@code {
    private Song? song;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        song = await context.Song.FirstOrDefaultAsync(m => m.Id == Id);

        if (song is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private static string GetImageSrc(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "images/default-cover.jpg";
        value = value.Trim();

        if (value.StartsWith("//")) return "https:" + value;
        if (value.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
            return "https://" + value.Substring("http://".Length);
        if (value.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return value;

        return "/" + value.TrimStart('/');
    }
}
